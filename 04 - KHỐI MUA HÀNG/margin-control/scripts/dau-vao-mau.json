    "bien_muc_tieu":      {"unit": "ty le", "min": 0.0, "max": 0.5, "source_id": "GIA-DINH-19 người có thẩm quyền đặt"},
    "bien_san":           {"unit": "ty le", "min": 0.0, "max": 0.5, "source_id": "GIA-DINH-20 người có thẩm quyền đặt"}
  },
  "equations": [
    {"id": "cif_usd", "formula": "fob_usd + freight_usd + insurance_usd"},
    {"id": "cif_vnd", "formula": "cif_usd * fx"},
    {"id": "duty_vnd", "formula": "cif_vnd * duty_rate"},
    {"id": "vat_nk_vnd", "formula": "(cif_vnd + duty_vnd) * vat_rate"},
    {"id": "gia_von_ve_kho", "formula": "cif_vnd + duty_vnd + local_cost_vnd + other_fee_vnd + vat_nk_vnd * vat_khong_khau_tru"},
    {"id": "chi_phi_trien_khai", "formula": "lap_dat_vnd + van_chuyen_khach_vnd + dao_tao_vnd + chay_thu_vnd + tai_chinh_vnd + khac_vnd"},
    {"id": "gia_ban_thuc_thu", "formula": "gia_niem_yet_vnd * (1 - chiet_khau)"},
    {"id": "bao_hanh_du_phong", "formula": "gia_ban_thuc_thu * bao_hanh_rate"},
    {"id": "tong_gia_von", "formula": "gia_von_ve_kho + chi_phi_trien_khai + bao_hanh_du_phong"},
    {"id": "lai_gop", "formula": "gia_ban_thuc_thu - tong_gia_von"},
    {"id": "bien_gop", "formula": "lai_gop / gia_ban_thuc_thu"},
    {"id": "markup", "formula": "lai_gop / tong_gia_von"},
    {"id": "gia_ban_toi_thieu", "formula": "(gia_von_ve_kho + chi_phi_trien_khai) / (1 - bien_muc_tieu - bao_hanh_rate)"},
    {"id": "giam_gia_toi_da", "formula": "1 - gia_ban_toi_thieu / gia_niem_yet_vnd"},
    {"id": "giam_gia_toi_da_vnd", "formula": "gia_niem_yet_vnd - gia_ban_toi_thieu"},
    {"id": "chenh_muc_tieu", "formula": "bien_gop - bien_muc_tieu"},
    {"id": "chenh_san", "formula": "bien_gop - bien_san"}
  ],
  "outputs": ["gia_von_ve_kho", "chi_phi_trien_khai", "bao_hanh_du_phong", "tong_gia_von", "gia_ban_thuc_thu", "lai_gop", "bien_gop", "markup", "gia_ban_toi_thieu", "giam_gia_toi_da", "giam_gia_toi_da_vnd", "chenh_muc_tieu", "chenh_san"],
